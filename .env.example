# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o git.

# --- Servidor ---
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# true só quando servido por HTTPS
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# --- Banco ---
# Implementações registradas na DataSourceFactory: sqlite
DB_DRIVER=sqlite
# Caminho relativo à raiz do projeto
SQLITE_PATH=data/krisis.db

# --- Conta inicial ---
# Usadas só no primeiro uso, quando o banco ainda não tem usuário.
# Depois disso, nome, e-mail e senha são alterados em Configurações.
# Gere o hash com: npm run hash-password
# Use aspas simples no hash (ele contém o caractere $).
ADMIN_NAME=Seu nome
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD_HASH='$argon2id$...'

# --- Modelo de linguagem ---
# Motores registrados na EngineFactory: groq, fake
LLM_ENGINE=groq
LLM_MODEL=openai/gpt-oss-20b
# Só para modelos com raciocínio (gpt-oss): low | medium | high. Deixe vazio nos demais.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1024

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
