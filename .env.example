# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o git.

# --- Servidor ---
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# true só quando servido por HTTPS
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# --- Banco ---
# Implementações registradas na DataSourceFactory: sqlite
DB_DRIVER=sqlite
# Caminho relativo à raiz do projeto
SQLITE_PATH=data/krisis.db

# --- Conta inicial ---
# Usadas só no primeiro uso, quando o banco ainda não tem usuário.
# Depois disso, nome, e-mail e senha são alterados em Configurações.
# Gere o hash com: npm run hash-password
# Use aspas simples no hash (ele contém o caractere $).
ADMIN_NAME=Seu nome
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD_HASH='$argon2id$...'

# --- Modelo de linguagem ---
# Motores registrados na EngineFactory: groq, fake
LLM_ENGINE=groq
LLM_MODEL=openai/gpt-oss-20b
# Só para modelos com raciocínio (gpt-oss): low | medium | high. Deixe vazio nos demais.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1024

# --- Transcrição (fala → texto) ---
# Motores registrados na EngineFactory: groq, fake
# Sem GROQ_API_KEY, use fake aqui E em LLM_ENGINE: o servidor confere os dois motores na partida.
STT_ENGINE=groq
STT_MODEL=whisper-large-v3-turbo
# Código ISO-639-1 do idioma falado
STT_LANGUAGE=pt

# --- Voz do entrevistador (texto → fala) ---
# Motores registrados na EngineFactory: kokoro, fake. "none" desliga a voz (chat só com texto).
TTS_ENGINE=kokoro
# Vozes em português: pf_dora (feminina), pm_alex, pm_santa (masculinas)
TTS_VOICE=pf_dora
# Vozes oferecidas nos botões "Ouvir" de cada fala, para comparar na hora
TTS_VOICES=pf_dora,pm_alex,pm_santa
TTS_SPEED=1.0
KOKORO_BASE_URL=http://127.0.0.1:8880/v1
# Threads de CPU do Kokoro (8 foi o melhor nesta máquina: i7-1355U)
TTS_THREADS=8

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
